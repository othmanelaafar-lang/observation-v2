# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/observatoire_ia

# Optional API keys / tokens
GITHUB_TOKEN=

# ETL behavior
TARGET_COUNTRY_CODE=MA
TARGET_COUNTRY_NAME=Morocco
PAGE_SIZE=50
MAX_PAGES=2
ENABLE_ORCID=false
ENABLE_SCHOLAR=false
REQUEST_TIMEOUT=20

# Quality filters
AI_ONLY=true
REQUIRE_MOROCCAN_SIGNAL=true
MIN_ELITE_SCORE=45

# Anti-beginner filters (seniority)
REQUIRE_SENIORITY=true
MIN_WORKS_COUNT=30
MIN_H_INDEX=10
MIN_CITATIONS=300
MIN_GITHUB_FOLLOWERS=30
MIN_GITHUB_REPOS=10

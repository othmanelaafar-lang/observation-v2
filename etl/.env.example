# PostgreSQL connection string (only used with --no-db absent)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/observatoire_ia

# Optional API keys / tokens
# Strongly recommended: without it GitHub allows only 60 requests/hour.
GITHUB_TOKEN=

# ETL behavior
TARGET_COUNTRY_CODE=MA
TARGET_COUNTRY_NAME=Morocco
PAGE_SIZE=50
MAX_PAGES=2
ENABLE_ORCID=false
ENABLE_SCHOLAR=false
REQUEST_TIMEOUT=20

# OpenAlex
# Putting an email here joins the "polite pool" (faster, more reliable).
OPENALEX_MAILTO=
OPENALEX_MAX_RETRIES=3
OPENALEX_RETRY_BACKOFF_SECONDS=5
# Leave empty to auto-resolve the AI topic ids from the OpenAlex /topics endpoint.
OPENALEX_AI_TOPIC_IDS=
# Cap on authors hydrated by the --target-domains-only pipeline.
OPENALEX_MAX_TARGET_AUTHORS=400
OPENALEX_MIN_WORKS_COUNT=3
OPENALEX_MIN_H_INDEX=3
OPENALEX_MIN_TOPIC_RELEVANCE=0.15
OPENALEX_RECENT_YEARS_WINDOW=5
OPENALEX_MIN_RECENT_WORKS=1

# GitHub source
GITHUB_MAX_PROFILES=60
# Fetching /events costs one extra API call per user and rejects nearly everyone.
GITHUB_FETCH_EVENTS=false
GITHUB_REQUIRE_NOTABLE_REPO=false
GITHUB_REQUIRE_AI_TOPIC_REPO=false
GITHUB_REQUIRE_MOROCCAN_SIGNAL=true
GITHUB_MIN_ACCOUNT_AGE_YEARS=0

# Quality filters
AI_ONLY=true
REQUIRE_MOROCCAN_SIGNAL=true
DIASPORA_ONLY=false
MIN_ELITE_SCORE=0.1

# Anti-beginner filters (seniority) - disabled by default, enable for a stricter run
REQUIRE_SENIORITY=false
MIN_WORKS_COUNT=30
MIN_H_INDEX=10
MIN_CITATIONS=300
MIN_GITHUB_FOLLOWERS=30
MIN_GITHUB_REPOS=10

# Scoring / tiers
DEDUPE_MATCH_THRESHOLD=3
SCORE_WEIGHT_HINDEX_NORM=0.35
SCORE_WEIGHT_NOTABLE_REPOS=0.25
SCORE_WEIGHT_RECENT_CITATIONS=0.2
SCORE_WEIGHT_INSTITUTION_RECOGNITION=0.2
TIER_ELITE_THRESHOLD=0.65
TIER_CONFIRME_THRESHOLD=0.35
TIER_EMERGENT_THRESHOLD=0.1

# Debug
REJECTED_PROFILES_CSV_PATH=

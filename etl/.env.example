# PostgreSQL connection string (only used with --no-db absent)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/observatoire_ia

# Optional API keys / tokens
# Strongly recommended: without it GitHub allows only 60 requests/hour.
GITHUB_TOKEN=

# ETL behavior
TARGET_COUNTRY_CODE=MA
TARGET_COUNTRY_NAME=Morocco
PAGE_SIZE=50
MAX_PAGES=2
ENABLE_ORCID=false
ENABLE_SCHOLAR=false
REQUEST_TIMEOUT=20

# OpenAlex
# Putting an email here joins the "polite pool" (faster, more reliable).
OPENALEX_MAILTO=
OPENALEX_MAX_RETRIES=3
OPENALEX_RETRY_BACKOFF_SECONDS=5
# Leave empty to auto-resolve the AI topic ids from the OpenAlex /topics endpoint.
OPENALEX_AI_TOPIC_IDS=
# Cap on authors hydrated by the --target-domains-only pipeline.
OPENALEX_MAX_TARGET_AUTHORS=400
OPENALEX_MIN_WORKS_COUNT=3
OPENALEX_MIN_H_INDEX=3
OPENALEX_MIN_TOPIC_RELEVANCE=0.15
OPENALEX_RECENT_YEARS_WINDOW=5
OPENALEX_MIN_RECENT_WORKS=1

# GitHub source
GITHUB_MAX_PROFILES=60
# Fetching /events costs one extra API call per user and rejects nearly everyone.
GITHUB_FETCH_EVENTS=false
GITHUB_REQUIRE_NOTABLE_REPO=false
GITHUB_REQUIRE_AI_TOPIC_REPO=false
GITHUB_REQUIRE_MOROCCAN_SIGNAL=true
GITHUB_MIN_ACCOUNT_AGE_YEARS=0

# Quality filters
AI_ONLY=true
REQUIRE_MOROCCAN_SIGNAL=true
DIASPORA_ONLY=false
MIN_ELITE_SCORE=0.1

# AI focus: share of the author's works in AI subfields
# 1702 = Artificial Intelligence, 1707 = Computer Vision and Pattern Recognition.
# 0.25 = "works in AI", 0.5 = "AI is their identity".
AI_SUBFIELD_IDS=1702,1707
MIN_AI_PURITY=0.25
# Volume fallback: catches cross-disciplinary AI researchers whose share is low
# but whose absolute AI output is large (e.g. federated learning under wireless).
MIN_AI_WORKS=20
# Purity floor applied to the volume path, so a prolific non-AI researcher
# cannot qualify on incidental AI papers alone.
MIN_AI_PURITY_FLOOR=0.1

# Moroccan origin: how much affiliation evidence is required
MIN_MOROCCAN_AFFILIATION_YEARS=2
MIN_MOROCCAN_AFFILIATION_INSTITUTIONS=2
# ORCID enrichment reads each candidate's declared education/employment
# countries. It is the strongest available identity signal. 2 requests/profile.
ENABLE_ORCID_ENRICHMENT=true
ORCID_ENRICHMENT_SLEEP_SECONDS=0.2

# Tiers: absolute thresholds, comparable across runs
TIER_ELITE_MIN_H_INDEX=40
TIER_ELITE_MIN_AI_PURITY=0.5
TIER_ELITE_MIN_AI_WORKS=50
TIER_ELITE_MIN_RECENT_WORKS=1
TIER_CONFIRME_MIN_H_INDEX=25
TIER_EMERGENT_MIN_H_INDEX=10

# Anti-beginner filters (seniority) - disabled by default, enable for a stricter run
REQUIRE_SENIORITY=false
MIN_WORKS_COUNT=30
MIN_H_INDEX=10
MIN_CITATIONS=300
MIN_GITHUB_FOLLOWERS=30
MIN_GITHUB_REPOS=10

# Scoring (used as a sort key inside a tier, not to assign the tier)
DEDUPE_MATCH_THRESHOLD=3
SCORE_WEIGHT_HINDEX_NORM=0.35
SCORE_WEIGHT_NOTABLE_REPOS=0.25
SCORE_WEIGHT_RECENT_CITATIONS=0.2
SCORE_WEIGHT_INSTITUTION_RECOGNITION=0.2

# Debug / audit trails
REJECTED_PROFILES_CSV_PATH=
REVIEW_QUEUE_CSV_PATH=
